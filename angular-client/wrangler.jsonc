{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tap-hoa-chi-to-webshop",
  "compatibility_date": "2026-11-21",
  "main": "worker/index.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/grocery-store-angular/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health", "/health/ready"]
  },
  "vars": {
    "API_ORIGIN": "https://tap-hoa-chi-to-api.onrender.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
