{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "grocery-store-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "src/app/styles/global.css",
              "src/app/styles/layouts/PublicLayout.css",
              "src/app/styles/layouts/DashboardLayout.css",
              "src/app/styles/components/ProductCard.css",
              "src/app/styles/pages/CatalogPage.css",
              "src/app/styles/pages/ProductDetailPage.css",
              "src/app/styles/pages/CartPage.css",
              "src/app/styles/pages/CheckoutPage.css",
              "src/app/styles/pages/AuthPage.css",
              "src/app/styles/pages/OrderTrackingPage.css",
              "src/app/styles/pages/ManagementPage.css"
            ]
          },
          "configurations": { "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }], "outputHashing": "all", "optimization": { "fonts": false } }, "development": { "optimization": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "grocery-store-angular:build:production" }, "development": { "buildTarget": "grocery-store-angular:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": "7c73c526-75be-429b-895f-c5421d739d85"
  }
}
