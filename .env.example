# Frontend
VITE_API_BASE_URL=http://localhost:5261/api

# Local demo SQL Server database. Hosting configuration is managed separately.
ConnectionStrings__DefaultConnection=Server=localhost;Database=WebsiteOmnichannelDemo;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False

Jwt__Issuer=TapHoaChiTo
Jwt__Audience=TapHoaChiTo.Web
Jwt__Key=replace-with-a-random-32-character-minimum-key
Jwt__AccessTokenLifetimeMinutes=15

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:4200

Store__Name=Omnichannel Demo Store
Store__Email=store@example.test
Store__Address=Sample Store Address
Store__PhoneNumbers=

Goong__ApiKey=
Goong__OriginAddress=
Goong__AutoShippingRadiusKm=5
Goong__BaseShippingFee=10000

# Product image storage.
ImageStorage__Provider=Local
ImageStorage__LocalRootPath=App_Data/product-images
ImageStorage__MaxUploadBytes=5242880
ImageStorage__MaxImageDimension=1600
ImageStorage__WebpQuality=82

Smtp__Host=smtp.example.test
Smtp__Provider=Mock
Smtp__Port=587
Smtp__UserName=
Smtp__Password=
Smtp__FromEmail=store@example.test
Smtp__FromName=Omnichannel Demo Store

Sms__Provider=Mock
Sms__ApiKey=
Sms__Sender=TapHoaChiTo

DemoIdentity__Enabled=false
DemoIdentity__Accounts__0__Role=Admin
DemoIdentity__Accounts__0__Email=admin@example.test
DemoIdentity__Accounts__0__Password=replace-with-a-development-password
DemoIdentity__Accounts__1__Role=Manager
DemoIdentity__Accounts__1__Email=manager@example.test
DemoIdentity__Accounts__1__Password=replace-with-a-development-password
DemoIdentity__Accounts__2__Role=Seller
DemoIdentity__Accounts__2__Email=seller@example.test
DemoIdentity__Accounts__2__Password=replace-with-a-development-password
DemoIdentity__Accounts__3__Role=Buyer
DemoIdentity__Accounts__3__Email=buyer@example.test
DemoIdentity__Accounts__3__Password=replace-with-a-development-password

Order__PendingReservationMinutes=10
Print__ReceiptPaperWidthMm=58
Print__PriceTagWidthMm=60
Print__PriceTagHeightMm=40
